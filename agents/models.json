{
  "tiers": {
    "fable": "orchestrator class: the lead's scope, decision and integration work",
    "opus": "deep reasoning: reviewer, integrator, worker on request",
    "sonnet": "bounded work: scout, worker default",
    "haiku": "cheap work"
  },
  "hosts": {
    "claude": {
      "delivery": "agents/*.md, frontmatter model: holds the tier name",
      "models": { "fable": "fable", "opus": "opus", "sonnet": "sonnet", "haiku": "haiku" }
    },
    "codex": {
      "delivery": "generated ~/.codex/agents/<name>.toml via scripts/install-codex-agents.sh",
      "models": { "fable": "gpt-6-astra", "opus": "gpt-5.6-sol", "sonnet": "gpt-5.6-terra", "haiku": "gpt-5.6-luna" },
      "effort": { "fable": "high", "opus": "high", "sonnet": "medium", "haiku": "low" }
    },
    "devin": {
      "delivery": "copied to ~/.config/devin/agents/, model: rewritten to the session model",
      "models": { "fable": "swe-2-max", "opus": "swe-2-max", "sonnet": "swe-2-max", "haiku": "swe-2-max" }
    },
    "cursor": {
      "delivery": "~/.cursor/agents/, model: rewritten by scripts/install-cursor.sh",
      "models": { "fable": "inherit", "opus": "inherit", "sonnet": "inherit", "haiku": "inherit" }
    }
  }
}
